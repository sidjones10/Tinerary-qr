# Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# ── Required ────────────────────────────────────────────────────────────────
# The app will not boot without these.

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — bypasses RLS. Server-side only, never expose to a client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public origin. Used for share links, OG tags, sitemap and emails.
# Falls back to NEXT_PUBLIC_SITE_URL, then VERCEL_URL, then localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Required in production ──────────────────────────────────────────────────

# Shared secret for the scheduled-job endpoints (/api/cron/*, /api/reminders/send).
# These FAIL CLOSED: if this is unset, every cron endpoint returns 500 rather
# than running unauthenticated. Generate with: openssl rand -hex 32
CRON_SECRET=

# Resend (https://resend.com/api-keys) — all transactional email.
RESEND_API_KEY=re_your_api_key_here

# Resend webhook signing secret (https://resend.com/webhooks).
# Required by /api/webhooks/resend; delivery receipts are dropped without it.
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here


# ── Optional ────────────────────────────────────────────────────────────────

# Admin access. Comma-separated emails that reach /admin. Database
# `profiles.is_admin = true` or `profiles.role = 'admin'` also works and is
# preferred — this list is a bootstrap for the first admin.
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com

# Alternative public origin, used only if NEXT_PUBLIC_APP_URL is unset.
NEXT_PUBLIC_SITE_URL=

# Web push (https://web.dev/articles/push-notifications-web-push-protocol).
# Push notifications are silently inert without these three.
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Upstash Redis (https://console.upstash.com) — distributed rate limiting.
# WITHOUT these, lib/rate-limit.ts falls back to an in-memory Map, which on
# serverless is per-instance and therefore close to no rate limit at all.
# Strongly recommended before opening sign-ups.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Twilio — SMS phone verification and SMS invitations.
# All three are required together. Without them, phone verification refuses
# to send in production rather than pretending it succeeded.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890

# Phone verification tuning (defaults shown).
PHONE_CODE_EXPIRY_MINUTES=10
PHONE_MAX_ATTEMPTS=5

# Session timing, in milliseconds (client-side; defaults apply if unset).
NEXT_PUBLIC_SESSION_CHECK_INTERVAL=
NEXT_PUBLIC_SESSION_EXPIRY_WARNING=
NEXT_PUBLIC_AUTO_REFRESH_INTERVAL=

# Base URL for the external discovery API, if one is deployed.
NEXT_PUBLIC_API_URL=


# ── Development and test only ───────────────────────────────────────────────

# Route outbound mail through Resend's test domain.
USE_RESEND_TEST_DOMAIN=
# Recipient for scripts/test-resend.js and /api/admin/test-email.
TEST_EMAIL_TO=
