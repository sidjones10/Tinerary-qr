# Environment Variables
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to git (it's in .gitignore)

# Supabase (get from: https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend Email (get from: https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Resend Webhook Secret (get from: https://resend.com/webhooks — signing secret)
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# App URL (will be different for local vs production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private-launch access control (see lib/access-control.ts).
# Admin email(s) — full app + admin dashboard. Comma-separated.
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com
# The "select few" creators allowed to use the full app during soft launch.
# Comma-separated. (DB alternative: set profiles.role = 'creator'.)
NEXT_PUBLIC_ALLOWED_EMAILS=creator1@example.com,creator2@example.com

# Optional: Twilio SMS (when you're ready)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
